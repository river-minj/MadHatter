    "dialogueId": "DLG_001",
    "speakerName": "마을 이장",
    "dialogueType": "NPC",
    "line": "여기는 바람개비 마을이라네."
  },
  {
    "uniqueId": "DLG_001_04",
    "dialogueId": "DLG_001",
    "speakerName": "마을 이장",
    "dialogueType": "NPC",
    "line": "마침 부탁할 일이 있는데, 들어주겠나?"
