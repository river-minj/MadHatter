  {
    "uniqueId": "DLG_002_01",
    "dialogueId": "DLG_002",
    "speakerName": "마을 이장",
    "dialogueType": "NPC",
    "line": "마을 대장장이에게 전할 말이 있다네."
  },
  {
    "uniqueId": "DLG_002_02",
    "dialogueId": "DLG_002",
    "speakerName": "마을 이장",
    "dialogueType": "NPC",
    "line": "대장장이를 찾아가서 안부를 전해주게."
