  {
    "uniqueId": "DLG_003_02",
    "dialogueId": "DLG_003",
    "speakerName": "마을 이장",
    "dialogueType": "NPC",
    "line": "마을 동쪽에 있으니 찾아가 보게."
  },
  {
    "uniqueId": "DLG_004_01",
    "dialogueId": "DLG_004",
    "speakerName": "대장장이",
    "dialogueType": "NPC",
    "line": "오, 이장님이 보내셨군. 반갑네!"
