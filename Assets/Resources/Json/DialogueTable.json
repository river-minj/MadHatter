  {
    "uniqueId": "DLG_002_03",
    "dialogueId": "DLG_002",
    "speakerName": "플레이어",
    "dialogueType": "Monologue",
    "line": "알겠습니다. 대장장이를 찾아가 볼게요."
  },
  {
    "uniqueId": "DLG_003_01",
    "dialogueId": "DLG_003",
    "speakerName": "마을 이장",
    "dialogueType": "NPC",
    "line": "아직 대장장이를 만나지 못한 건가?"
